public setSessionMetadata(sessionId: string, meta: SessionMetadata, workDir?: string): void {
  // Think → writes to workspace-local: {workDir}/.consilium/sessions/think/{sessionId}.json
  // Do    → writes to {workDir}/.consilium/sessions/regular/{sessionId}/state.json
  writeThinkSessionTitle(sessionId, meta.title, meta.titleSource, meta.titleGeneratedAt, workDir);
