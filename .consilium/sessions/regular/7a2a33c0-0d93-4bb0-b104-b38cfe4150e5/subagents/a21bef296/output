## 7. Agent File Resolution

In `bridge-handler.ts:12-38`:

```typescript
function resolveAgentFile(activeTab, workspaceRoot, extensionRoot): string | undefined {
  const agentName = activeTab === 'think' ? 'think.yaml' : 'do.yaml';

  // 1. Workspace-local: {workspaceRoot}/.consilium/agents/{think|do}.yaml
  if (workspaceRoot) {
    const localPath = path.join(workspaceRoot, '.consilium', 'agents', agentName);
    if (fs.existsSync(localPath)) return localPath;
  }

  // 2. Built-in profile template from extension resources
  const profile = VSCodeSettings.agentProfile;   // "default" | "reverse-engineering" | "embedded"
  if (profile && extensionRoot) {
    const templatePath = path.join(extensionRoot, 'resources', 'agent-profiles', profile, agentName);
    if (fs.existsSync(templatePath)) return templatePath;
  }

  // 3. Fallback: no --agent-file → CLI uses default
  return undefined;
}
```

