## 2. How the CLI Process is Spawned (`ProtocolClient.start`)

In `agent_sdk/protocol.ts:158-213`:

```typescript
async start(options: ClientOptions): Promise<InitializeResult> {
  const args = this.buildArgs(options);   // builds command-line args
  const executable = options.executablePath ?? "consilium";

  const { executable: actualExecutable, args: actualArgs } = spawnWindowsSafe(executable, args);

  this.process = spawn(actualExecutable, actualArgs, {
    cwd: options.workDir,         // <--- working directory = workDir!
    env: { ...cleanEnv, ...options.environmentVariables },
    stdio: ["pipe", "pipe", "pipe"],
  });
  // ... set up readline, stderr, exit handlers ...

  const initResult = await this.sendInitialize(options.externalTools, options.clientInfo, hookSubscriptions);
  return initResult;
}
```

### The `buildArgs` method (`protocol.ts:382-427`):

```typescript
private buildArgs(options: ClientOptions): string[] {
  const args = [];
  if (options.sessionId)   args.push("--session", options.sessionId);
  args.push("--work-dir", options.workDir, "--wire");

  if (options.model)       args.push("--model", options.model);
  if (options.thinking)    args.push("--thinking"); else args.push("--no-thinking");
  if (options.yoloMode)    args.push("--yolo");
  if (options.doMode)      args.push("--do");
  if (options.agentFile)   args.push("--agent-file", options.agentFile);

  // Subagent system prompts: --subagent-system-prompt key=path
  if (options.subagentSystemPrompts) {
    for (const [name, path] of Object.entries(options.subagentSystemPrompts)) {
      args.push("--subagent-system-prompt", `${name}=${path}`);
    }
  }

  if (options.skillsDir)                 args.push("--skills-dir", options.skillsDir);
  if (options.generationOverrides) {
    if (temperature !== undefined) args.push("--temperature", temperature.toString());
    if (topP !== undefined)        args.push("--top-p", topP.toString());
    if (maxTokens !== undefined)   args.push("--max-tokens", maxTokens.toString());
  }
  return args;
}
```

**So the CLI is spawned with:** `consilium --session <uuid> --work-dir <path> --wire --model <model> --thinking/--no-thinking --yolo/--do`

