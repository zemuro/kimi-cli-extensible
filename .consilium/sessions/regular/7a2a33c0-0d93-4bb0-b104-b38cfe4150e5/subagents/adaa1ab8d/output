/** Close a session with a timeout guard to prevent hung processes from leaking. */
async function safeCloseSession(session: Session, label: string, timeoutMs = 5000): Promise<void> {
  const closePromise = session.close();
  let timer: NodeJS.Timeout | undefined;
  const timeoutPromise = new Promise<void>((_, reject) => {
    timer = setTimeout(() => reject(new Error(`close() timed out after ${timeoutMs}ms`)), timeoutMs);
  });
  try {
    await Promise.race([closePromise, timeoutPromise]);
  } catch (err) {
    sessionLog.error("safeCloseSession failed", { label, error: String(err) });
  } finally {
    clearTimeout(timer);
  }
}

export class BridgeHandler {
  private sessions = new Map<string, Session>();
  private turns = new Map<string, Turn>();
  private customWorkDirs = new Map<string, string>(); // webviewId -> custom workDir
  private fileManager: FileManager;
  private activeTabs = new Map<string, 'think' | 'do'>();

  constructor(
    private broadcast: BroadcastFn,
