function resolveAgentFile(
  activeTab: 'think' | 'do',
  workspaceRoot: string | null,
  extensionRoot: string,
): string | undefined {
  const agentName = activeTab === 'think' ? 'think.yaml' : 'do.yaml';

  // 1. Workspace-local override
  if (workspaceRoot) {
    const localPath = path.join(workspaceRoot, '.consilium', 'agents', agentName);
    if (fs.existsSync(localPath)) {
      return localPath;
    }
  }

  // 2. Built-in profile template
  const profile = VSCodeSettings.agentProfile;
  if (profile && extensionRoot) {
    const templatePath = path.join(extensionRoot, 'resources', 'agent-profiles', profile, agentName);
    if (fs.existsSync(templatePath)) {
      return templatePath;
    }
  }

  // 3. Fallback to CLI default (no --agent-file)
  return undefined;
}

function resolveSubagentRoleOverrides(
  workspaceRoot: string | null,
  extensionRoot: string,
): Record<string, string> | undefined {
  if (!workspaceRoot || !extensionRoot) {
    return undefined;
  }

  const workspaceAgentsDir = path.join(workspaceRoot, '.consilium', 'agents');
  const workspaceRolePath = path.join(workspaceAgentsDir, 'plan_editor_role.md');

  // 1. Workspace-local role file takes precedence.
  if (fs.existsSync(workspaceRolePath)) {
    console.log(`[Bridge] Using workspace plan_editor role override: ${workspaceRolePath}`);
    return { plan_editor: workspaceRolePath };
  }

  // 2. Seed from built-in profile template if available.
  const profile = VSCodeSettings.agentProfile;
  if (profile) {
    const profileRolePath = path.join(extensionRoot, 'resources', 'agent-profiles', profile, 'plan_editor_role.md');
    if (fs.existsSync(profileRolePath)) {
      fs.mkdirSync(workspaceAgentsDir, { recursive: true });
      fs.copyFileSync(profileRolePath, workspaceRolePath);
      console.log(`[Bridge] Seeded workspace plan_editor role from profile ${profile}: ${workspaceRolePath}`);
      return { plan_editor: workspaceRolePath };
    }
  }

  // 3. No override; use CLI built-in default.
  console.log('[Bridge] No workspace/profile plan_editor role override found; using CLI default');
  return undefined;
}

