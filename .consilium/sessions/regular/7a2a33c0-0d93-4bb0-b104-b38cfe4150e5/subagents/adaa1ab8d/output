function resolveAgentFile(
  activeTab: 'think' | 'do',
  workspaceRoot: string | null,
  extensionRoot: string,
): string | undefined {
  const agentName = activeTab === 'think' ? 'think.yaml' : 'do.yaml';

  // 1. Workspace-local override
  if (workspaceRoot) {
    const localPath = path.join(workspaceRoot, '.consilium', 'agents', agentName);
    if (fs.existsSync(localPath)) {
      return localPath;
    }
  }

  // 2. Built-in profile template
  const profile = VSCodeSettings.agentProfile;
  if (profile && extensionRoot) {
    const templatePath = path.join(extensionRoot, 'resources', 'agent-profiles', profile, agentName);
    if (fs.existsSync(templatePath)) {
      return templatePath;
    }
  }

  // 3. Fallback to CLI default (no --agent-file)
  return undefined;
}

function resolveSubagentRoleOverrides(
  workspaceRoot: string | null,
  extensionRoot: string,
): Record<string, string> | undefined {
  if (!workspaceRoot || !extensionRoot) {
    return undefined;
  }

  const workspaceAgentsDir = path.join(workspaceRoot, '.consilium', 'agents');
  const workspaceRolePath = path.join(workspaceAgentsDir, 'plan_editor_role.md');

  // 1. Workspace-local role file takes precedence.
  if (fs.existsSync(workspaceRolePath)) {
    console.log(`[Bridge] Using workspace plan_editor role override: ${workspaceRolePath}`);
    return { plan_editor: workspaceRolePath };
  }

  // 2. Seed from built-in profile template if available.
  const profile = VSCodeSettings.agentProfile;
  if (profile) {
    const profileRolePath = path.join(extensionRoot, 'resources', 'agent-profiles', profile, 'plan_editor_role.md');
    if (fs.existsSync(profileRolePath)) {
      fs.mkdirSync(workspaceAgentsDir, { recursive: true });
      fs.copyFileSync(profileRolePath, workspaceRolePath);
      console.log(`[Bridge] Seeded workspace plan_editor role from profile ${profile}: ${workspaceRolePath}`);
      return { plan_editor: workspaceRolePath };
    }
  }

  // 3. No override; use CLI built-in default.
  console.log('[Bridge] No workspace/profile plan_editor role override found; using CLI default');
  return undefined;
}

interface RpcMessage {
  id: string;
  method: string;
  params?: unknown;
}

interface RpcResult {
  id: string;
  result?: unknown;
  error?: string;
}

/** Close a session with a timeout guard to prevent hung processes from leaking. */
async function safeCloseSession(session: Session, label: string, timeoutMs = 5000): Promise<void> {
  const closePromise = session.close();
  let timer: NodeJS.Timeout | undefined;
  const timeoutPromise = new Promise<void>((_, reject) => {
    timer = setTimeout(() => reject(new Error(`close() timed out after ${timeoutMs}ms`)), timeoutMs);
  });
  try {
    await Promise.race([closePromise, timeoutPromise]);
  } catch (err) {
    sessionLog.error("safeCloseSession failed", { label, error: String(err) });
  } finally {
    clearTimeout(timer);
  }
}

export class BridgeHandler {
  private sessions = new Map<string, Session>();
  private turns = new Map<string, Turn>();
  private customWorkDirs = new Map<string, string>(); // webviewId -> custom workDir
  private fileManager: FileManager;
  private activeTabs = new Map<string, 'think' | 'do'>();

  constructor(
    private broadcast: BroadcastFn,
    private workspaceState: vscode.Memento,
    private globalState: vscode.Memento,
    private reloadWebview: ReloadWebviewFn,
    private showLogs: ShowLogsFn,
    private extensionRoot: string,
  ) {
    this.fileManager = new FileManager(() => this.workspaceRoot, broadcast);
    
    // PERSISTENCE TEST
    const testKey = 'consilium-persistence-test-v2';
    const existing = this.workspaceState.get(testKey, 0) as number;
    sessionLog.log("PERSISTENCE TEST", { existing });
    this.workspaceState.update(testKey, existing + 1).then(() => {
      sessionLog.log("PERSISTENCE TEST updated", { value: existing + 1 });
    });
  }

  async handle(msg: RpcMessage, webviewId: string): Promise<RpcResult> {
    try {
      if (msg.method === "setActiveTab") {
        const { tab } = (msg.params as any) || {};
        sessionLog.log("SETTING activeTab", { webviewId, tab });
        this.activeTabs.set(webviewId, tab);
        await this.persistTabState(webviewId);
        return { id: msg.id, result: { ok: true, setTo: tab } };
      }

      sessionLog.log("handle RPC", { method: msg.method, webviewId, activeTab: this.activeTabs.get(webviewId) ?? 'default-think' });
      return {
        id: msg.id,
        result: await this.dispatch(msg.method, msg.params, webviewId),
      };
    } catch (err) {
      return {
        id: msg.id,
        error: err instanceof Error ? err.message : String(err),
      };
    }
  }

  private getSessionKey(webviewId: string): string {
    const tab = this.activeTabs.get(webviewId) ?? 'think';
    const key = tab === 'think' ? webviewId : `${webviewId}:do`;
    sessionLog.log("getSessionKey", { webviewId, tab, key });
    return key;
  }

  private tabStateKey(webviewId: string): string {
    const type = webviewId.startsWith('sidebar') ? 'sidebar' : 'panel';
    return `consilium-dual-tab-state-${type}`;
  }

  private persistTabState(webviewId: string): void {
    const thinkSession = this.sessions.get(webviewId);
    const doSession = this.sessions.get(`${webviewId}:do`);
    const activeTab = this.activeTabs.get(webviewId) ?? 'think';
    const data = {
      thinkSessionId: thinkSession?.sessionId ?? null,
      doSessionId: doSession?.sessionId ?? null,
      activeTab,
    };
    sessionLog.log("persistTabState", { webviewId, data });
    this.workspaceState.update(this.tabStateKey(webviewId), data);
  }

  private restoreTabState(webviewId: string): { thinkSessionId?: string; doSessionId?: string; activeTab?: 'think' | 'do' } {
    return this.workspaceState.get(this.tabStateKey(webviewId), {});
