        <ConfigErrorScreen type={status} cliResult={cliResult} errorMessage={errorMessage} />
        <Toaster position="top-center" />
      </div>
    );
  }

  // 正常状态
  return (
    <div className="flex flex-col h-screen text-foreground overflow-hidden">
