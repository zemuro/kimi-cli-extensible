    // Batch events via requestAnimationFrame to prevent main thread saturation
    // during high-frequency streams (thinking tokens, tool call parts).
    let pendingEvents: UIStreamEvent[] = [];
    let flushScheduled = false;

    const flush = () => {
      flushScheduled = false;
      const batch = pendingEvents;
      pendingEvents = [];
      if (batch.length === 0) return;

      // Process all buffered events in a single state update
      for (const event of batch) {
        processEvent(event);
      }

      // Handle errors from the batch
      for (const event of batch) {
        if (event.type === "error") {
          const streamError = event as StreamError;
          if (isPreflightError(streamError.code || "UNKNOWN")) {
            toast.error(streamError.message);
          }
        }
      }
    };

    const scheduleFlush = () => {
      if (flushScheduled) return;
