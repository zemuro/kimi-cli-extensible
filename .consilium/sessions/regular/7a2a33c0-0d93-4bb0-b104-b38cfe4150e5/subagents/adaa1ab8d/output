  public setSessionMetadata(sessionId: string, meta: SessionMetadata, workDir?: string): void {
    const isThink = meta.mode === "think";

    // Write title to authoritative file storage when possible.
    // An empty string title intentionally clears a previously set title.
    if (isThink) {
      writeThinkSessionTitle(
        sessionId,
        meta.title ?? "",
        meta.titleSource ?? "user",
        meta.titleGeneratedAt,
        workDir,
      );
    } else if (workDir) {
      writeSessionTitle(
        workDir,
        sessionId,
        meta.title ?? "",
        meta.titleSource ?? "user",
        meta.titleGeneratedAt,
      );
    }

    // Keep globalState as the source of truth for mode and as a fallback/cache.
    const key = `consilium-session-meta-${sessionId}`;
    const existing: SessionMetadata | undefined = this.globalState.get(key);
    this.globalState.update(key, { ...existing, ...meta });
  }

  public getSessionMetadata(sessionId: string, workDir?: string): SessionMetadata | undefined {
    // Start from legacy globalState sidecar for mode and fallback title.
    const key = `consilium-session-meta-${sessionId}`;
    const sidecar: SessionMetadata | undefined = this.globalState.get(key);
    const isThink = sidecar?.mode === "think";

    // Prefer file-based title storage.
    if (!isThink && workDir) {
      const fileTitle = readSessionTitle(workDir, sessionId);
      if (fileTitle) {
        return {
          mode: sidecar?.mode,
          title: fileTitle.title,
          titleSource: fileTitle.source,
          titleGeneratedAt: fileTitle.generatedAt,
        };
      }
    }

    const thinkTitle = readThinkSessionTitle(sessionId, workDir);
    if (thinkTitle) {
      return {
        mode: sidecar?.mode ?? "think",
        title: thinkTitle.title,
        titleSource: thinkTitle.source,
        titleGeneratedAt: thinkTitle.generatedAt,
      };
    }

    return sidecar;
  }

  private get workspaceRoot(): string | null {
    return vscode.workspace.workspaceFolders?.[0]?.uri.fsPath ?? null;
  }

  private getWorkDir(webviewId: string): string | null {
    return this.customWorkDirs.get(webviewId) ?? this.workspaceRoot;
  }

  setCustomWorkDir(webviewId: string, workDir: string | null): void {
    if (workDir && workDir !== this.workspaceRoot) {
      this.customWorkDirs.set(webviewId, workDir);
    } else {
      this.customWorkDirs.delete(webviewId);
    }
    // Close sessions when workDir changes
    this.sessions.get(webviewId)?.close();
    this.sessions.delete(webviewId);
    this.turns.delete(webviewId);

    const doKey = `${webviewId}:do`;
    this.sessions.get(doKey)?.close();
    this.sessions.delete(doKey);
    this.turns.delete(doKey);

    this.fileManager.clearTracked(webviewId);
    this.fileManager.clearTracked(doKey);
  }

  private requireWorkDir(webviewId: string): string {
    const w = this.getWorkDir(webviewId);
    if (!w) {
      throw new Error("No workspace folder open");
    }
    return w;
  }

  private async dispatch(method: string, params: unknown, webviewId: string): Promise<unknown> {
    const handler = handlers[method];
    if (!handler) {
      throw new Error(`Unknown method: ${method}`);
    }
    return handler(params, this.createContext(webviewId));
  }

  private createContext(webviewId: string): HandlerContext {
    return {
      webviewId,
      workDir: this.getWorkDir(webviewId),
      workspaceRoot: this.workspaceRoot,
      workspaceState: this.workspaceState,
      requireWorkDir: () => this.requireWorkDir(webviewId),
      broadcast: this.broadcast,
      fileManager: this.fileManager,
      reloadWebview: () => this.reloadWebview(webviewId),
      showLogs: this.showLogs,
      setSessionMetadata: (sessionId, meta) => this.setSessionMetadata(sessionId, meta, this.getWorkDir(webviewId) ?? undefined),
      getSessionMetadata: (sessionId) => this.getSessionMetadata(sessionId, this.getWorkDir(webviewId) ?? undefined),
      getRestoredTabState: () => this.restoreTabState(webviewId),
      getSession: () => this.sessions.get(this.getSessionKey(webviewId)),
      getSessionId: () => this.fileManager.getSessionId(this.getSessionKey(webviewId)),
      getFileManagerKey: () => this.getSessionKey(webviewId),
      getTurn: () => this.turns.get(this.getSessionKey(webviewId)),
      setTurn: (turn: Turn | null) => {
        const key = this.getSessionKey(webviewId);
        if (turn) {
          this.turns.set(key, turn);
        } else {
          this.turns.delete(key);
        }
      },
      getOrCreateSession: (model, thinking, sessionId, mode) => this.getOrCreateSession(webviewId, model, thinking, sessionId, mode),
      closeSession: async () => {
        const key = this.getSessionKey(webviewId);
        const session = this.sessions.get(key);
        if (session) {
          await session.close();
          this.sessions.delete(key);
        }
        this.turns.delete(key);
      },
      saveAllDirty: () => this.saveAllDirty(),
      setCustomWorkDir: (workDir: string | null) => this.setCustomWorkDir(webviewId, workDir),
    };
  }

  private async saveAllDirty(): Promise<void> {
    const dirty = vscode.workspace.textDocuments.filter((d) => d.isDirty && !d.isUntitled);
    await Promise.all(dirty.map((d) => d.save()));
  }

  private async getOrCreateSession(webviewId: string, model: string, thinking: boolean, sessionId?: string, mode?: 'think' | 'do'): Promise<Session> {
    const workDir = this.requireWorkDir(webviewId);
    const cli = getCLIManager();
    const config = parseConfig();

    // Determine actual thinking state based on model capability
    const modelConfig = getModelById(config.models, model);
    const thinkingMode = modelConfig ? getModelThinkingMode(modelConfig) : "none";

    let actualThinking: boolean;
    if (thinkingMode === "always") {
      actualThinking = true;
    } else if (thinkingMode === "none") {
      actualThinking = false;
    } else {
      actualThinking = thinking;
    }

    const executable = cli.getExecutablePath();
    const env = VSCodeSettings.environmentVariables;
    const globalYoloMode = VSCodeSettings.yoloMode;
    const requestedMode = mode ?? 'think';
    const actualDoMode = requestedMode === 'do';
    const actualYoloMode = actualDoMode ? true : globalYoloMode;
    const generationConfig = VSCodeSettings.generationConfig;

    const key = requestedMode === 'do' ? `${webviewId}:do` : webviewId;
    const agentFile = resolveAgentFile(requestedMode, this.workspaceRoot, this.extensionRoot);
    const subagentSystemPrompts = resolveSubagentRoleOverrides(this.workspaceRoot, this.extensionRoot);
    sessionLog.log("getOrCreateSession", { webviewId, requestedSessionId: sessionId, existingKey: key, model, yoloMode: actualYoloMode, doMode: actualDoMode, agentFile: agentFile ?? '<default>' });
    const existing = this.sessions.get(key);

    // Guard against silently converting an existing session from one mode to another.
    // This prevents a Do session loaded into the Think tab from being overwritten.
    if (existing && sessionId && sessionId === existing.sessionId && existing.doMode !== actualDoMode) {
      throw new Error(
        `Session ${sessionId} is a ${existing.doMode ? 'Do' : 'Think'} session. ` +
        `Switch to the ${existing.doMode ? 'Do' : 'Think'} tab before continuing.`
      );
    }

    // Check if we need to restart the session
    if (existing) {
      const needsRestart =
        (sessionId && sessionId !== existing.sessionId) ||
        model !== existing.model ||
        actualThinking !== existing.thinking ||
        actualYoloMode !== existing.yoloMode ||
        actualDoMode !== existing.doMode ||
        executable !== existing.executable ||
        JSON.stringify(env) !== JSON.stringify(existing.env) ||
        JSON.stringify(generationConfig) !== JSON.stringify((existing as any)._generationOverrides);

      if (needsRestart) {
        await safeCloseSession(existing, key);
        this.sessions.delete(key);
        this.turns.delete(key);
      }
    }

    const current = this.sessions.get(key);
    if (current) {
      return current;
    }

    const session = createSession({
      workDir,
      model,
      thinking: actualThinking,
      yoloMode: actualYoloMode,
      doMode: actualDoMode,
      sessionId,
      executable,
      env,
      agentFile,
      subagentSystemPrompts,
      clientInfo: { name: "consilium-code-for-vs-code", version: VSCodeSettings.getExtensionConfig().version },
      generationOverrides: generationConfig.temperature !== undefined || generationConfig.topP !== undefined || generationConfig.maxTokens !== undefined
        ? generationConfig
        : undefined,
    });

    this.sessions.set(key, session);
    this.fileManager.setSessionId(key, session.sessionId);
    this.persistTabState(webviewId);
    return session;
  }

  async disposeView(webviewId: string): Promise<void> {
    // Close think session
    const thinkSession = this.sessions.get(webviewId);
    if (thinkSession) {
      await safeCloseSession(thinkSession, webviewId);
      this.sessions.delete(webviewId);
      this.turns.delete(webviewId);
    }
    this.fileManager.disposeView(webviewId);

    // Close do session
    const doKey = `${webviewId}:do`;
    const doSession = this.sessions.get(doKey);
    if (doSession) {
      await safeCloseSession(doSession, doKey);
      this.sessions.delete(doKey);
      this.turns.delete(doKey);
    }
    this.fileManager.disposeView(doKey);

    // Clear active tab
    this.activeTabs.delete(webviewId);
  }

  async dispose(): Promise<void> {
    this.fileManager.dispose();
    for (const s of this.sessions.values()) {
      await s.close();
    }
    this.sessions.clear();
    this.turns.clear();
  }
}
