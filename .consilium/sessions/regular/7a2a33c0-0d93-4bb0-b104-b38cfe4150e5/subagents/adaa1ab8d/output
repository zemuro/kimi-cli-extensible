        <Header />
        <SetupScreen onSetupSuccess={handleSetupSuccess} />
        <Toaster position="top-center" />
      </div>
    );
  }

  // 如果没有模型
  if (modelsCount === 0 && status === "no-models") {
    return (
      <div className="flex flex-col h-screen text-foreground overflow-hidden">
        <Header />
        <ConfigErrorScreen type="no-models" cliResult={cliResult} errorMessage={errorMessage} onRefresh={refresh} onOpenSetup={() => setForceShowSetup(true)} />
        <Toaster position="top-center" />
      </div>
    );
  }

  // 其他错误状态
  if (status === "cli-error" || status === "no-workspace") {
