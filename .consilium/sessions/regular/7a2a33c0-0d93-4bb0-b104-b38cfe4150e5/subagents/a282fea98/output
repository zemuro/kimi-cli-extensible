### `setActiveTab` 动作（第 259–272 行）

```ts
setActiveTab: (tab: 'think' | 'do') => {
  const state = get();
  if (state.activeTab === tab) return;

  set(produce((draft: ChatState) => {
    // Save full outgoing tab state
    syncTabStateFromFlat(draft, draft.activeTab);
    // Load incoming tab state into flat
    syncFlatStateFromTab(draft, tab);
    draft.activeTab = tab;
  }));

  bridge.setActiveTab(tab);
},
```

**关键点：** 切换标签时，先将当前扁平状态保存到 `draft.activeTab`（即退出标签），然后将即将激活的标签状态加载到扁平状态。`pendingInput` 随此同步。

### `syncFlatStateFromTab` 和 `syncTabStateFromFlat`（第 86–115 行）

```ts
/** Copy all mirrored fields from active tab → flat state (for component reads). */
function syncFlatStateFromTab(draft: ChatState, tab: 'think' | 'do') {
  draft.sessionId = draft[tab].sessionId;
  draft.messages = draft[tab].messages;
  draft.isStreaming = draft[tab].isStreaming;
  draft.isCompacting = draft[tab].isCompacting;
  draft.lastStatus = draft[tab].lastStatus;
  draft.tokenUsage = draft[tab].tokenUsage;
  draft.activeTokenUsage = draft[tab].activeTokenUsage;
  draft.pendingInput = draft[tab].pendingInput;
  draft.planMode = draft[tab].planMode;
  draft.pendingQuestion = draft[tab].pendingQuestion;
  draft.title = draft[tab].title;
  draft.titleSource = draft[tab].titleSource;
}

/** Copy all mirrored fields from flat state → tab (for tab switching). */
function syncTabStateFromFlat(draft: ChatState, tab: 'think' | 'do') {
  draft[tab].sessionId = draft.sessionId;
  draft[tab].messages = draft.messages;
  draft[tab].isStreaming = draft.isStreaming;
  draft[tab].isCompacting = draft.isCompacting;
  draft[tab].lastStatus = draft.lastStatus;
  draft[tab].tokenUsage = draft.tokenUsage;
  draft[tab].activeTokenUsage = draft.activeTokenUsage;
  draft[tab].pendingInput = draft.pendingInput;
  draft[tab].planMode = draft.planMode;
  draft[tab].pendingQuestion = draft.pendingQuestion;
  draft[tab].title = draft.title;
  draft[tab].titleSource = draft.titleSource;
}
```

**这两个函数互为逆操作。** 它们同步一组"镜像字段"，包括 `pendingInput`。扁平状态（`ChatState`）实际上是当前激活标签的快捷方式/代理。`pendingInput` 是这些镜像字段之一，因此在标签切换时被保存和恢复。

