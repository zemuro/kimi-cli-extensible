async function listThinkSessions(): Promise<SessionInfo[]> {
  const dir = getThinkDir();
  console.log("[session.handler] listThinkSessions dir:", dir, "exists:", fs.existsSync(dir));
  if (!fs.existsSync(dir)) return [];
  const entries = await fs.promises.readdir(dir, { withFileTypes: true });
  const sessions: SessionInfo[] = [];
  for (const e of entries) {
    if (!e.isDirectory() && e.name.endsWith(".jsonl")) {
      const id = e.name.slice(0, -".jsonl".length);
      if (!UUID_REGEX.test(id)) continue;
      const filePath = path.join(dir, e.name);
      const st = await fs.promises.stat(filePath);
      const brief = (await getFirstUserMessageFromThinkFile(filePath)) || DEFAULT_FALLBACK_TITLE;
      sessions.push({
        id: id,
        workDir: "[Think]",
        updatedAt: st.mtimeMs || st.mtime.getTime(),
        contextFile: filePath,
        brief,
        isThinking: true
      });
    }
  }
  return sessions.sort((a, b) => b.updatedAt - a.updatedAt);
}
```

**`sessionHandlers`** object — Lines 84-374:

